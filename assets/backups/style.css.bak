/* ═══════════════════════════════════════════════════════════
   NONAGNI DAVID — PORTFOLIO  ·  style.css
   Aesthetic: Cinematic B&W · ASCII-futurist · Editorial
   Fonts: Big Shoulders Display · Syne · JetBrains Mono
   ═══════════════════════════════════════════════════════════ */

/* ── ROOT DESIGN TOKENS ──────────────────────────────────── */
:root {
  color-scheme: dark;

  /* Backgrounds */
  --bg:          oklch(0.065 0 0);
  --bg-2:        oklch(0.09 0.003 72);
  --surface:     oklch(0.12 0.004 72);
  --surface-hi:  oklch(0.16 0.005 72);

  /* Text */
  --text:        oklch(0.93 0.008 72);
  --text-2:      oklch(0.60 0.010 72);
  --text-3:      oklch(0.38 0.007 72);

  /* Accents */
  --accent:      oklch(0.72 0.15 62);
  --accent-dim:  oklch(0.72 0.15 62 / 0.16);
  --cool:        oklch(0.72 0.11 196);
  --cool-dim:    oklch(0.72 0.11 196 / 0.14);

  /* Borders */
  --line:        oklch(0.93 0.008 72 / 0.10);
  --line-hi:     oklch(0.93 0.008 72 / 0.22);

  /* Radii — deliberately sharp */
  --r-xs: 2px;
  --r-sm: 5px;
  --r-md: 10px;

  /* Shadows */
  --shadow: 0 28px 90px oklch(0 0 0 / 0.55);

  /* Typography */
  --font-display: 'Big Shoulders Display', sans-serif;
  --font-body:    'Syne', system-ui, sans-serif;
  --font-mono:    'JetBrains Mono', 'SFMono-Regular', Consolas, monospace;

  font-family: var(--font-body);
  background: var(--bg);
  color: var(--text);
}

/* ── RESET ───────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; }

html { min-height: 100%; scroll-behavior: smooth; }

body {
  position: relative;
  min-height: 100%;
  margin: 0;
  overflow-x: hidden;
  background:
    radial-gradient(ellipse at 50% 0%, oklch(0.11 0.004 72) 0%, var(--bg) 58%),
    var(--bg);
}

/* Ambient dot-grid texture */
body::before {
  position: fixed;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  content: "";
  background-image:
    radial-gradient(oklch(0.93 0.008 72 / 0.055) 1px, transparent 1px);
  background-size: 36px 36px;
  mask-image: radial-gradient(ellipse at 50% 30%, black 20%, transparent 72%);
}

a { color: inherit; text-decoration: none; }
button { font: inherit; }

pre {
  margin: 0;
  font-family: var(--font-mono);
}

/* Typography base */
h1, h2, h3, h4, p { margin-top: 0; }

h1 {
  font-family: var(--font-body);
  font-weight: 700;
  font-size: clamp(1.7rem, 2.8vw, 2.6rem);
  line-height: 1.15;
  letter-spacing: -0.01em;
  color: var(--text);
  max-width: 760px;
  margin-bottom: 24px;
}

h2 {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: clamp(2.8rem, 5.5vw, 7rem);
  line-height: 0.88;
  text-transform: uppercase;
  letter-spacing: -0.015em;
  color: var(--text);
  margin-bottom: 18px;
}

h3 {
  font-family: var(--font-body);
  font-size: clamp(0.95rem, 1.2vw, 1.1rem);
  font-weight: 700;
  letter-spacing: 0.01em;
  margin-bottom: 10px;
  color: var(--text);
}

p {
  font-size: clamp(0.92rem, 1.1vw, 1.02rem);
  font-weight: 400;
  line-height: 1.74;
  color: var(--text-2);
}

/* AOS flash prevention */
body:not(.aos-ready) [data-aos] {
  opacity: 1 !important;
  transform: none !important;
}

/* ── ASCII FIELD (canvas BG) ─────────────────────────────── */
.ascii-field {
  position: fixed;
  inset: 0;
  z-index: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  opacity: 0.9;
}

/* ── PRELOADER ───────────────────────────────────────────── */
.preloader {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20px;
  background: var(--bg);
  color: var(--text-2);
}

.preloader p {
  margin: 0;
  color: var(--text-3);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.preloader-cube {
  overflow: visible;
  filter: drop-shadow(0 0 28px oklch(0.72 0.15 62 / 0.28));
  width: clamp(180px, 17vw, 240px);
  height: auto;
}

/* ── PAGE SHELL ──────────────────────────────────────────── */
.page-shell {
  position: relative;
  z-index: 1;
  width: 100%;
  overflow: visible;
}

/* ── SITE HEADER ─────────────────────────────────────────── */
.site-header {
  position: sticky;
  top: 0;
  z-index: 20;
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 20px;
  padding: 18px clamp(18px, 4vw, 56px);
  border-bottom: 1px solid var(--line);
  background: oklch(0.065 0 0 / 0.88);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.brand,
.site-nav,
.header-actions {
  display: flex;
  align-items: center;
}

.brand {
  gap: 10px;
  justify-self: start;
  min-width: 0;
  color: var(--text);
  font-family: var(--font-body);
  font-size: 0.82rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.brand-glyph {
  display: grid;
  width: 32px;
  height: 32px;
  place-items: center;
  border: 1px solid var(--line-hi);
  border-radius: var(--r-sm);
  background: var(--surface);
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 500;
}

/* Nav pill */
.site-nav {
  justify-self: center;
  gap: 2px;
  padding: 4px;
  border: 1px solid var(--line-hi);
  border-radius: 999px;
  background: var(--text);
  color: var(--bg);
  box-shadow: 0 12px 36px oklch(0 0 0 / 0.4);
}

.site-nav a {
  min-width: 78px;
  padding: 10px 14px;
  border-radius: 999px;
  font-family: var(--font-body);
  font-size: 0.74rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  text-align: center;
  transition: background 160ms ease, color 160ms ease, transform 160ms ease;
}

.site-nav a:hover,
.site-nav a:focus-visible {
  background: var(--bg);
  color: var(--text);
  outline: none;
  transform: translateY(-1px);
}

/* Header right actions */
.header-actions {
  justify-self: end;
  gap: 10px;
}

.lang-toggle,
.footer-lang,
.header-cta,
.button {
  border: 1px solid var(--line-hi);
  border-radius: 999px;
  cursor: pointer;
}

.lang-toggle {
  min-width: 44px;
  min-height: 38px;
  background: var(--surface);
  color: var(--text);
  font-family: var(--font-mono);
  font-size: 0.7rem;
  font-weight: 500;
  letter-spacing: 0.06em;
}

.header-cta {
  display: inline-flex;
  align-items: center;
  min-height: 38px;
  padding: 0 18px;
  background: var(--surface);
  color: var(--text);
  font-family: var(--font-body);
  font-size: 0.78rem;
  font-weight: 700;
  transition: background 160ms ease, transform 160ms ease;
}

.header-cta:hover {
  background: var(--surface-hi);
  transform: translateY(-1px);
}

.menu-toggle { display: none; }

/* ── SECTION BAND (shared) ───────────────────────────────── */
.section-band {
  position: relative;
  padding: clamp(72px, 8vw, 128px) clamp(20px, 5vw, 72px);
}

/* ── SECTION HEADER ──────────────────────────────────────── */
.section-head {
  display: grid;
  grid-template-columns: minmax(140px, 0.36fr) minmax(0, 1fr);
  gap: clamp(20px, 5vw, 60px);
  align-items: start;
  margin-bottom: clamp(40px, 6vw, 72px);
  padding-top: 28px;
  border-top: 1px solid var(--line-hi);
}

.section-head.compact { max-width: 1040px; }

.section-index {
  margin: 0 0 0;
  padding-top: 4px;
  color: var(--text-3);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

/* ═══════════════════════════════════════════════════════════
   HERO SECTION
   ═══════════════════════════════════════════════════════════ */
.hero {
  display: grid;
  grid-template-columns: 1fr 0.54fr;
  grid-template-rows: auto 1fr auto;
  grid-template-areas:
    "strip-t  strip-t"
    "copy     console"
    "strip-b  strip-b";
  min-height: 100vh;
  padding: 0;
  position: relative;
  overflow: hidden;
  border-bottom: 1px solid var(--line-hi);
}

/* Horizontal CRT scanlines */
.hero::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 4;
  pointer-events: none;
  background: repeating-linear-gradient(
    0deg,
    transparent 0px,
    transparent 3px,
    oklch(0 0 0 / 0.09) 3px,
    oklch(0 0 0 / 0.09) 4px
  );
}

/* ── Viewfinder corner markers ── */
.hero-corner {
  position: absolute;
  z-index: 5;
  width: 18px;
  height: 18px;
  pointer-events: none;
}

.hero-corner.tl { top: 22px;  left: 22px;
  border-top: 1px solid var(--text-3);
  border-left: 1px solid var(--text-3); }
.hero-corner.tr { top: 22px;  right: 22px;
  border-top: 1px solid var(--text-3);
  border-right: 1px solid var(--text-3); }
.hero-corner.bl { bottom: 22px; left: 22px;
  border-bottom: 1px solid var(--text-3);
  border-left: 1px solid var(--text-3); }
.hero-corner.br { bottom: 22px; right: 22px;
  border-bottom: 1px solid var(--text-3);
  border-right: 1px solid var(--text-3); }

/* ── Film-strip metadata bars ── */
.hero-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 11px clamp(24px, 5vw, 72px);
  font-family: var(--font-mono);
  font-size: 0.62rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--text-3);
  z-index: 2;
}

.hero-strip-top {
  grid-area: strip-t;
  border-bottom: 1px solid var(--line);
}

.hero-strip-bottom {
  grid-area: strip-b;
  border-top: 1px solid var(--line);
}

/* ── Hero copy (left) ── */
.hero-copy {
  grid-area: copy;
  position: relative;
  z-index: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: clamp(48px, 6vw, 88px) clamp(24px, 5vw, 72px);
  border-right: 1px solid var(--line);
}

/* ── CINEMATIC NAME ── */
.hero-name {
  margin-bottom: clamp(24px, 3.5vw, 44px);
  font-family: var(--font-display);
  font-weight: 900;
  font-size: clamp(4.4rem, 11.5vw, 14.5rem);
  line-height: 0.87;
  letter-spacing: -0.01em;
  text-transform: uppercase;
  user-select: none;
}

/* Overflow clip for title-card slide-up reveal */
.hero-name-clip { overflow: hidden; }

/* First line: solid white */
.hero-name-a {
  display: block;
  color: var(--text);
}

/* Second line: outlined / hollow — editorial contrast */
.hero-name-b {
  display: block;
  color: transparent;
  -webkit-text-stroke: 1.5px oklch(0.93 0.008 72 / 0.52);
  text-stroke: 1.5px oklch(0.93 0.008 72 / 0.52);
}

/* Kicker label */
.ascii-kicker {
  margin: 0 0 14px;
  color: var(--cool);
  font-family: var(--font-mono);
  font-size: 0.74rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

/* H1 tagline */
.hero .hero-copy h1 {
  font-family: var(--font-body);
  font-weight: 700;
  font-size: clamp(1.5rem, 2.5vw, 2.4rem);
  line-height: 1.2;
  margin-bottom: 18px;
}

/* Typewriter lead */
.hero-lead {
  max-width: 640px;
  min-height: 4em;
  margin-bottom: 36px;
  color: var(--text-2);
  font-size: clamp(0.95rem, 1.5vw, 1.18rem);
  font-weight: 400;
  line-height: 1.76;
}

.typewriter-text { color: var(--text); }

.typing-cursor {
  display: inline-block;
  width: 2px;
  height: 1.1em;
  margin-left: 2px;
  vertical-align: -0.15em;
  background: var(--cool);
  animation: blink 1s step-end infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50%       { opacity: 0; }
}

/* ── Hero buttons ── */
.hero-actions,
.contact-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0 26px;
  font-family: var(--font-body);
  font-size: 0.86rem;
  font-weight: 700;
  letter-spacing: 0.02em;
  transition: transform 160ms ease, box-shadow 160ms ease, background 160ms ease;
}

.button:hover,
.button:focus-visible {
  outline: none;
  transform: translateY(-2px);
}

.button-primary {
  background: var(--text);
  color: var(--bg);
  border-color: var(--text);
}

.button-primary:hover {
  background: oklch(0.82 0.008 72);
  box-shadow: 0 12px 32px oklch(0 0 0 / 0.5);
}

.button-secondary {
  background: var(--surface);
  color: var(--text);
}

.button-secondary:hover {
  background: var(--surface-hi);
  box-shadow: 0 12px 32px oklch(0 0 0 / 0.4);
}

/* ── Hero console (right) ── */
.hero-console {
  grid-area: console;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--bg-2);
}

.console-top {
  display: flex;
  align-items: center;
  gap: 7px;
  min-height: 44px;
  padding: 0 18px;
  border-bottom: 1px solid var(--line);
  color: var(--text-3);
  flex-shrink: 0;
}

.console-top span {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  flex-shrink: 0;
}

.console-top span:nth-child(1) { background: var(--accent); }
.console-top span:nth-child(2) { background: var(--cool); }
.console-top span:nth-child(3) { background: var(--text-3); }

.console-top p {
  margin: 0 0 0 7px;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.06em;
  color: var(--text-3);
}

.hero-console pre {
  flex: 1;
  overflow-x: auto;
  padding: clamp(24px, 3.5vw, 44px) clamp(20px, 3vw, 38px);
  color: var(--cool);
  font-size: clamp(0.65rem, 1.05vw, 0.88rem);
  line-height: 1.78;
  text-shadow: 0 0 20px oklch(0.72 0.11 196 / 0.22);
}

/* ── Status indicator ── */
.status-indicator {
  display: flex;
  align-items: center;
  gap: 8px;
}

.status-dot {
  flex-shrink: 0;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 8px var(--accent);
  animation: pulse-dot 2.8s ease infinite;
}

@keyframes pulse-dot {
  0%, 100% { opacity: 1;   box-shadow: 0 0 8px  var(--accent); }
  50%       { opacity: 0.5; box-shadow: 0 0 3px  var(--accent); }
}

/* ═══════════════════════════════════════════════════════════
   SERVICES SECTION
   ═══════════════════════════════════════════════════════════ */
.service-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1px;
  border: 1px solid var(--line-hi);
  border-radius: var(--r-sm);
  overflow: hidden;
  background: var(--line-hi);
}

.service-card {
  display: flex;
  flex-direction: column;
  padding: clamp(22px, 3vw, 36px) clamp(20px, 2.5vw, 32px);
  background: var(--surface);
  border-top: 2px solid transparent;
  transition: border-top-color 240ms ease, background 240ms ease;
  cursor: default;
}

.service-card:hover {
  border-top-color: var(--accent);
  background: var(--surface-hi);
}

/* Large decorative number */
.card-num {
  display: block;
  font-family: var(--font-display);
  font-weight: 900;
  font-size: clamp(2.4rem, 4vw, 5rem);
  line-height: 1;
  letter-spacing: -0.02em;
  color: var(--line-hi);
  margin-bottom: 14px;
  transition: color 240ms ease;
}

.service-card:hover .card-num {
  color: var(--accent-dim);
}

.service-card h3 {
  margin-bottom: 8px;
  font-size: 0.96rem;
  font-weight: 700;
  color: var(--text);
}

.service-card p {
  margin: 0;
  font-size: 0.88rem;
  line-height: 1.68;
  color: var(--text-2);
  flex: 1;
}

/* ═══════════════════════════════════════════════════════════
   PROCESS SECTION
   ═══════════════════════════════════════════════════════════ */
.process-list {
  display: grid;
  gap: 0;
  max-width: 1100px;
  margin: 0;
  padding: 0;
  list-style: none;
  counter-reset: process-step;
}

.process-list li {
  display: grid;
  grid-template-columns: minmax(180px, 0.3fr) minmax(0, 1fr);
  gap: 24px;
  align-items: baseline;
  padding: 26px 0;
  border-top: 1px solid var(--line);
  transition: background 200ms ease;
}

.process-list li:last-child {
  border-bottom: 1px solid var(--line);
}

.process-list span {
  font-family: var(--font-display);
  font-weight: 900;
  font-size: clamp(1.1rem, 2vw, 1.9rem);
  text-transform: uppercase;
  letter-spacing: -0.01em;
  color: var(--accent);
  line-height: 1;
}

.process-list p {
  margin: 0;
  font-size: 0.96rem;
  line-height: 1.72;
  color: var(--text-2);
  max-width: 740px;
}

/* ═══════════════════════════════════════════════════════════
   PROOF / WORK SECTION  — Image containers
   ═══════════════════════════════════════════════════════════ */
.proof-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(16px, 2.5vw, 28px);
}

.proof-card {
  display: flex;
  flex-direction: column;
}

/* ── Screenshot frame ── */
.proof-img {
  position: relative;
  width: 100%;
  aspect-ratio: 16 / 10;
  background: oklch(0.09 0.003 72);
  border: 1px solid var(--line-hi);
  border-top: 2px solid var(--line-hi);
  overflow: hidden;
  margin-bottom: 16px;
  transition: border-top-color 240ms ease;
}

.proof-card:hover .proof-img {
  border-top-color: var(--accent);
}

/* Corner mark TL */
.proof-img::before {
  content: '';
  position: absolute;
  top: 10px; left: 10px;
  width: 14px; height: 14px;
  border-top: 1px solid var(--text-3);
  border-left: 1px solid var(--text-3);
  z-index: 1;
}

/* Corner mark BR */
.proof-img::after {
  content: '';
  position: absolute;
  bottom: 10px; right: 10px;
  width: 14px; height: 14px;
  border-bottom: 1px solid var(--text-3);
  border-right: 1px solid var(--text-3);
  z-index: 1;
}

/* Center placeholder label */
.proof-img-label {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  font-family: var(--font-mono);
  font-size: 0.6rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--text-3);
  pointer-events: none;
  white-space: nowrap;
}

/* Bottom-left case index */
.proof-img-idx {
  position: absolute;
  bottom: 12px; left: 14px;
  font-family: var(--font-mono);
  font-size: 0.58rem;
  letter-spacing: 0.12em;
  color: var(--text-3);
  pointer-events: none;
}

/* Real image inside .proof-img — drop <img> directly inside the div */
.proof-img img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Card body (below image) */
.proof-card-body {
  padding: 2px 2px 8px;
  flex: 1;
}

.proof-num {
  margin-bottom: 4px;
  color: var(--cool);
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.proof-card-body h3 {
  margin-bottom: 10px;
  font-size: 0.98rem;
  color: var(--text);
}

.proof-tag {
  display: inline-flex;
  width: fit-content;
  padding: 5px 12px;
  border: 1px solid oklch(0.72 0.15 62 / 0.28);
  border-radius: 999px;
  color: var(--accent);
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.06em;
}

/* ═══════════════════════════════════════════════════════════
   EXPERIENCE / BACKGROUND SECTION
   ═══════════════════════════════════════════════════════════ */
.experience-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1px;
  border: 1px solid var(--line-hi);
  border-radius: var(--r-sm);
  overflow: hidden;
  background: var(--line-hi);
}

.experience-grid article {
  min-height: 220px;
  padding: clamp(24px, 3vw, 36px);
  background: var(--surface);
  border-top: 2px solid transparent;
  transition: border-top-color 240ms ease, background 240ms ease;
}

.experience-grid article:hover {
  border-top-color: var(--cool);
  background: var(--surface-hi);
}

.experience-grid h3 {
  margin-bottom: 10px;
  color: var(--text);
}

.experience-grid p {
  margin: 0;
  font-size: 0.9rem;
  line-height: 1.7;
  color: var(--text-2);
}

/* ═══════════════════════════════════════════════════════════
   STACK SECTION
   ═══════════════════════════════════════════════════════════ */
.stack-board {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border: 1px solid var(--line-hi);
  border-radius: var(--r-sm);
  overflow: hidden;
  background: var(--line);
  gap: 1px;
}

.stack-group {
  min-height: 320px;
  padding: clamp(22px, 3vw, 36px);
  background: var(--surface);
}

.stack-group h3 {
  margin-bottom: 20px;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--text-3);
}

.logo-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.logo-grid li {
  display: flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: var(--r-sm);
  background: var(--bg-2);
  color: var(--text-2);
  font-size: 0.78rem;
  font-weight: 600;
  transition: border-color 200ms ease, color 200ms ease;
}

.logo-grid li:hover {
  border-color: var(--line-hi);
  color: var(--text);
}

.logo-grid img {
  display: block;
  width: 26px;
  height: 26px;
  object-fit: contain;
  flex-shrink: 0;
  padding: 2px;
  border-radius: 5px;
  background: oklch(0.93 0.008 72 / 0.08);
}

.logo-grid span { min-width: 0; }

/* ═══════════════════════════════════════════════════════════
   WHY / SIGNAL SECTION
   ═══════════════════════════════════════════════════════════ */
.why-panel {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(260px, 0.6fr);
  gap: clamp(28px, 4vw, 56px);
  align-items: center;
  padding: clamp(32px, 4vw, 56px);
  border: 1px solid var(--line-hi);
  border-radius: var(--r-md);
  background: var(--surface);
}

.why-panel > p {
  margin: 0;
  font-size: clamp(1.05rem, 1.9vw, 1.55rem);
  font-weight: 500;
  line-height: 1.68;
  color: var(--text);
}

.why-panel pre {
  overflow: auto;
  color: var(--cool);
  font-size: clamp(0.74rem, 1.1vw, 0.92rem);
  line-height: 1.82;
  text-shadow: 0 0 16px oklch(0.72 0.11 196 / 0.2);
}

/* ═══════════════════════════════════════════════════════════
   CONTACT SECTION
   ═══════════════════════════════════════════════════════════ */
.contact-section {
  border-top: 1px solid var(--line-hi);
}

.contact-panel {
  max-width: 1080px;
  margin: 0 auto;
  padding: clamp(40px, 6vw, 80px) clamp(32px, 5vw, 72px);
  border: 1px solid var(--line-hi);
  border-radius: var(--r-md);
  background: var(--surface);
  text-align: left;
}

.contact-panel .section-index { margin-bottom: 20px; }

.contact-panel h2 {
  font-size: clamp(3rem, 8vw, 10rem);
  margin-bottom: 20px;
  line-height: 0.88;
}

.contact-panel p:not(.section-index) {
  max-width: 640px;
  margin-bottom: 32px;
  font-size: 1rem;
  color: var(--text-2);
}

/* ═══════════════════════════════════════════════════════════
   FOOTER
   ═══════════════════════════════════════════════════════════ */
.site-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 22px clamp(20px, 5vw, 72px) 32px;
  border-top: 1px solid var(--line);
  color: var(--text-3);
}

.site-footer pre {
  white-space: pre-wrap;
  font-size: 0.74rem;
  letter-spacing: 0.06em;
}

.footer-lang {
  min-height: 38px;
  padding: 0 16px;
  background: transparent;
  color: var(--text-2);
  font-family: var(--font-body);
  font-size: 0.78rem;
  font-weight: 600;
  transition: color 160ms ease;
}

.footer-lang:hover { color: var(--text); }

/* ═══════════════════════════════════════════════════════════
   RESPONSIVE — 1080px
   ═══════════════════════════════════════════════════════════ */
@media (max-width: 1080px) {
  .site-header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
  }

  .menu-toggle {
    display: inline-grid;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid var(--line-hi);
    border-radius: 999px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 17px;
    height: 1.5px;
    margin: 2.5px 0;
    border-radius: 999px;
    background: currentColor;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  .site-header.is-open .menu-toggle span:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  .site-header.is-open .menu-toggle span:nth-child(2) { opacity: 0; }
  .site-header.is-open .menu-toggle span:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  .site-nav, .header-actions { display: none; width: 100%; }

  .site-header.is-open .site-nav,
  .site-header.is-open .header-actions { display: flex; }

  .site-nav {
    flex-direction: column;
    align-items: stretch;
    border-radius: 16px;
  }

  .site-nav a { width: 100%; min-width: 0; text-align: left; }

  .header-actions { flex-direction: column; align-items: stretch; }
  .header-cta, .lang-toggle { justify-content: center; width: 100%; }

  .service-grid,
  .proof-grid,
  .experience-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stack-board {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero-strip span:nth-child(3) { display: none; }
}

/* ═══════════════════════════════════════════════════════════
   RESPONSIVE — 720px
   ═══════════════════════════════════════════════════════════ */
@media (max-width: 720px) {
  .site-header {
    top: 0;
    padding: 14px 16px;
    padding-right: 64px;
  }

  .menu-toggle {
    position: absolute;
    top: 14px;
    right: clamp(14px, calc(100vw - 376px), 120px);
    z-index: 30;
    display: inline-grid !important;
    background: var(--text);
    color: var(--bg);
  }

  .brand { font-size: 0.74rem; }

  /* Hero: single column */
  .hero {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto 1fr auto;
    grid-template-areas:
      "strip-t"
      "copy"
      "console"
      "strip-b";
  }

  .hero-copy { border-right: none; border-bottom: 1px solid var(--line); }

  .hero-name { font-size: clamp(3.8rem, 16vw, 7rem); }

  .hero-console pre {
    min-height: 220px;
    white-space: pre;
    font-size: 0.6rem;
  }

  .hero-strip span:nth-child(2) { display: none; }

  .section-band { padding: 60px 16px; }

  .section-head,
  .section-head.compact {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .service-grid,
  .proof-grid,
  .experience-grid,
  .stack-board,
  .why-panel {
    grid-template-columns: 1fr;
  }

  .why-panel { padding: clamp(22px, 4vw, 36px); }

  .process-list li { grid-template-columns: 1fr; gap: 8px; }

  .button { width: 100%; }

  .site-footer { flex-direction: column; align-items: flex-start; }

  .contact-panel { padding: 28px 20px; }
}

/* ═══════════════════════════════════════════════════════════
   RESPONSIVE — 520px
   ═══════════════════════════════════════════════════════════ */
@media (max-width: 520px) {
  .hero { padding-top: 0; }

  .hero-copy { padding: 32px 16px; }

  .hero-name {
    font-size: clamp(3.2rem, 18vw, 6rem);
    margin-bottom: 20px;
  }

  .hero-name-b {
    -webkit-text-stroke-width: 1px;
  }

  .hero-lead {
    font-size: 0.9rem;
    min-height: 5.5em;
    overflow-wrap: break-word;
  }

  .hero-actions .button { width: min(100%, 320px); }

  .hero-console pre {
    font-size: 0.52rem;
    min-height: 200px;
    padding: 16px;
  }

  h2 { font-size: clamp(2.4rem, 14vw, 4.5rem); }

  .contact-panel h2 { font-size: clamp(2.8rem, 16vw, 5rem); }

  .service-card,
  .experience-grid article {
    min-height: 180px;
  }

  .stack-group { min-height: auto; }
}

/* ═══════════════════════════════════════════════════════════
   REDUCED MOTION
   ═══════════════════════════════════════════════════════════ */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }
}
