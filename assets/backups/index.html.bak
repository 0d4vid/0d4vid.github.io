<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Nonagni David — AI automation builder in Douala, Cameroon. n8n automation, AI integration, ETL pipelines, web development, data science, analytics." />
    <title>Nonagni David · AI Automation Builder</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@700;800;900&family=Syne:wght@400;500;600;700;800&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;1,300&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://unpkg.com" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://unpkg.com/aos@next/dist/aos.css" />
    <link rel="stylesheet" href="style.css" />
  </head>
  <body>
    <canvas class="ascii-field" id="ascii-field" aria-hidden="true"></canvas>

    <div class="preloader" id="preloader" aria-label="Loading portfolio">
      <svg class="preloader-cube" viewBox="0 0 60 60" width="220" stroke="#55524e" stroke-linejoin="round" aria-hidden="true">
        <g id="preloaderCube" fill="#1a1916">
          <path id="preloaderBase"></path>
          <path id="preloaderLid"></path>
        </g>
      </svg>
      <p data-i18n="preloader">assembling signal map</p>
    </div>

    <main class="page-shell">

      <!-- ── HEADER ─────────────────────────────────── -->
      <header class="site-header" id="top">
        <a class="brand" href="#top" aria-label="Nonagni David home">
          <span class="brand-glyph" aria-hidden="true">0d</span>
          <span>Nonagni David</span>
        </a>

        <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>

        <nav class="site-nav" aria-label="Primary navigation">
          <a href="#services"  data-i18n="navServices">Services</a>
          <a href="#process"   data-i18n="navProcess">Process</a>
          <a href="#proof"     data-i18n="navProof">Proof</a>
          <a href="#stack"     data-i18n="navStack">Stack</a>
          <a href="#contact"   data-i18n="navContact">Contact</a>
        </nav>

        <div class="header-actions">
          <button class="lang-toggle" type="button" data-lang-toggle aria-label="Switch language">FR</button>
          <a class="header-cta" href="#contact" data-i18n="navCta">Discuss a project</a>
        </div>
      </header>

      <!-- ── HERO ───────────────────────────────────── -->
      <section class="hero section-band" aria-labelledby="hero-title">

        <!-- Viewfinder corner markers -->
        <span class="hero-corner tl" aria-hidden="true"></span>
        <span class="hero-corner tr" aria-hidden="true"></span>
        <span class="hero-corner bl" aria-hidden="true"></span>
        <span class="hero-corner br" aria-hidden="true"></span>

        <!-- Top film-strip metadata -->
        <div class="hero-strip hero-strip-top" aria-hidden="true">
          <span>0d4vid ® PORTFOLIO</span>
          <span>~/automation/ai/data/web</span>
          <span>DOUALA · CM · AF</span>
        </div>

        <!-- Left: cinematic copy -->
        <div class="hero-copy">
          <div class="hero-name" aria-hidden="true">
            <div class="hero-name-clip"><span class="hero-name-a">NONAGNI</span></div>
            <div class="hero-name-clip"><span class="hero-name-b">DAVID</span></div>
          </div>

          <p class="ascii-kicker" aria-hidden="true">~/automation/signal/index</p>
          <h1 id="hero-title" data-i18n="heroTitle">Build systems. Automate work.</h1>
          <p class="hero-lead">
            <span data-i18n="heroLeadPrefix">I help teams with </span>
            <span class="typewriter-text" data-typewriter></span>
            <span class="typing-cursor" aria-hidden="true"></span>
          </p>
          <div class="hero-actions">
            <a class="button button-primary"   href="mailto:nonagnijordan@gmail.com" data-i18n="heroPrimary">Discuss a project</a>
            <a class="button button-secondary" href="#services" data-i18n="heroSecondary">Explore services</a>
          </div>
        </div>

        <!-- Right: ASCII system map -->
        <div class="hero-console">
          <div class="console-top">
            <span></span><span></span><span></span>
            <p>signal.graph</p>
          </div>
          <pre aria-label="ASCII service map">
╔═[0d4vid.signal.graph]══════════╗
║                                 ║
║  · n8n automation  › workflows  ║
║  · AI integration  › RAG/agents ║
║  · ETL pipelines   › data layer ║
║  · web development › react/APIs ║
║  · app development › tools/mob  ║
║  · data analysis   › ML/viz     ║
║                                 ║
║ ─────────────────────────────── ║
║                                 ║
║  INPUT:  workflow_raw           ║
║  OUTPUT: measurable_outcome     ║
║  METHOD: diagnose→design→build  ║
║  STATUS: ● AVAILABLE            ║
║                                 ║
╚═════════════════════════════════╝</pre>
        </div>

        <!-- Bottom film-strip status -->
        <div class="hero-strip hero-strip-bottom" aria-hidden="true">
          <span class="status-indicator">
            <span class="status-dot"></span>
            <span data-i18n="heroStatus">AVAILABLE FOR PROJECT</span>
          </span>
          <span>4°03'N · 9°42'E</span>
          <span>B3 IABD · KEYCE · ORBIT SARL</span>
        </div>

      </section>

      <!-- ── SERVICES / CAPABILITIES ────────────────── -->
      <section class="section-band services-section" id="services" aria-labelledby="services-title">
        <div class="section-head" data-aos="fade-up">
          <p class="section-index">/ 01</p>
          <div>
            <h2 id="services-title" data-i18n="servicesTitle">Capabilities.</h2>
            <p data-i18n="servicesLead">Each offer is scoped to reduce manual work, connect existing tools, and leave you with systems that can be maintained after delivery.</p>
          </div>
        </div>

        <div class="service-grid">
          <article class="service-card" data-aos="fade-up" data-aos-delay="0">
            <span class="card-num">01</span>
            <h3 data-i18n="serviceN8nTitle">n8n automation</h3>
            <p data-i18n="serviceN8nText">Workflow design for lead handling, reporting, notifications, data sync, approvals, and internal operations.</p>
          </article>
          <article class="service-card" data-aos="fade-up" data-aos-delay="80">
            <span class="card-num">02</span>
            <h3 data-i18n="serviceAiTitle">AI integration</h3>
            <p data-i18n="serviceAiText">AI assistants, RAG patterns, document processing, prompt workflows, and integrations that fit existing products.</p>
          </article>
          <article class="service-card" data-aos="fade-up" data-aos-delay="160">
            <span class="card-num">03</span>
            <h3 data-i18n="serviceEtlTitle">ETL and data warehouse</h3>
            <p data-i18n="serviceEtlText">Data extraction, cleaning, transformation, warehouse-ready structures, analytics foundations, and operational dashboards.</p>
          </article>
          <article class="service-card" data-aos="fade-up" data-aos-delay="240">
            <span class="card-num">04</span>
            <h3 data-i18n="serviceWebTitle">Web development</h3>
            <p data-i18n="serviceWebText">Responsive websites, frontend interfaces, backend services, APIs, and practical product experiences.</p>
          </article>
          <article class="service-card" data-aos="fade-up" data-aos-delay="320">
            <span class="card-num">05</span>
            <h3 data-i18n="serviceAppTitle">App development</h3>
            <p data-i18n="serviceAppText">Mobile and desktop application support, product prototypes, workflow tools, and internal apps.</p>
          </article>
          <article class="service-card" data-aos="fade-up" data-aos-delay="400">
            <span class="card-num">06</span>
            <h3 data-i18n="serviceDataTitle">Data science</h3>
            <p data-i18n="serviceDataText">Exploratory analysis, ML prototypes, model evaluation, dashboards, and decisions supported by structured evidence.</p>
          </article>
        </div>
      </section>

      <!-- ── PROCESS ─────────────────────────────────── -->
      <section class="section-band process-section" id="process" aria-labelledby="process-title">
        <div class="section-head compact" data-aos="fade-up">
          <p class="section-index">/ 02</p>
          <div>
            <h2 id="process-title" data-i18n="processTitle">Process.</h2>
          </div>
        </div>

        <ol class="process-list">
          <li data-aos="fade-right">
            <span>diagnose</span>
            <p data-i18n="processDiagnose">Map the current workflow, data sources, manual steps, constraints, and real success criteria.</p>
          </li>
          <li data-aos="fade-right" data-aos-delay="80">
            <span>design</span>
            <p data-i18n="processDesign">Define the automation, data flow, user touchpoints, fallback paths, and handoff expectations.</p>
          </li>
          <li data-aos="fade-right" data-aos-delay="160">
            <span>build</span>
            <p data-i18n="processBuild">Implement workflows, integrations, pipelines, interfaces, and dashboards with clear checkpoints.</p>
          </li>
          <li data-aos="fade-right" data-aos-delay="240">
            <span>stabilize</span>
            <p data-i18n="processStabilize">Test edge cases, document usage, prepare maintenance notes, and make the system understandable.</p>
          </li>
        </ol>
      </section>

      <!-- ── PROOF / WORK ────────────────────────────── -->
      <section class="section-band proof-section" id="proof" aria-labelledby="proof-title">
        <div class="section-head" data-aos="fade-up">
          <p class="section-index">/ 03</p>
          <div>
            <h2 id="proof-title" data-i18n="proofTitle">Work proof.</h2>
            <p data-i18n="proofLead">These frames are ready for screenshots, dashboards, and case study details. Replace the placeholder with an &lt;img&gt; when the project is ready.</p>
          </div>
        </div>

        <div class="proof-grid">
          <article class="proof-card" data-aos="zoom-in">
            <!-- Drop your screenshot inside .proof-img as an <img> tag -->
            <div class="proof-img" role="img" aria-label="Case 01 screenshot placeholder">
              <span class="proof-img-label" aria-hidden="true">INSERT SCREENSHOT</span>
              <span class="proof-img-idx"   aria-hidden="true">case_01</span>
            </div>
            <div class="proof-card-body">
              <p class="proof-num" aria-hidden="true">case_01</p>
              <h3 data-i18n="proofAutomation">Automation system</h3>
              <span class="proof-tag" data-i18n="proofPending">Details pending</span>
            </div>
          </article>

          <article class="proof-card" data-aos="zoom-in" data-aos-delay="100">
            <div class="proof-img" role="img" aria-label="Case 02 screenshot placeholder">
              <span class="proof-img-label" aria-hidden="true">INSERT SCREENSHOT</span>
              <span class="proof-img-idx"   aria-hidden="true">case_02</span>
            </div>
            <div class="proof-card-body">
              <p class="proof-num" aria-hidden="true">case_02</p>
              <h3 data-i18n="proofData">Data pipeline</h3>
              <span class="proof-tag" data-i18n="proofPending">Details pending</span>
            </div>
          </article>

          <article class="proof-card" data-aos="zoom-in" data-aos-delay="200">
            <div class="proof-img" role="img" aria-label="Case 03 screenshot placeholder">
              <span class="proof-img-label" aria-hidden="true">INSERT SCREENSHOT</span>
              <span class="proof-img-idx"   aria-hidden="true">case_03</span>
            </div>
            <div class="proof-card-body">
              <p class="proof-num" aria-hidden="true">case_03</p>
              <h3 data-i18n="proofProduct">Web or app build</h3>
              <span class="proof-tag" data-i18n="proofPending">Details pending</span>
            </div>
          </article>
        </div>
      </section>

      <!-- ── EXPERIENCE / BACKGROUND ────────────────── -->
      <section class="section-band experience-section" id="experience" aria-labelledby="experience-title">
        <div class="section-head compact" data-aos="fade-up">
          <p class="section-index">/ 04</p>
          <div>
            <h2 id="experience-title" data-i18n="experienceTitle">Background.</h2>
          </div>
        </div>

        <div class="experience-grid">
          <article data-aos="fade-up">
            <h3>Orbit SARL</h3>
            <p data-i18n="orbitText">Software engineering and AI intern in Logpom, Douala, focused on software and applied AI development.</p>
          </article>
          <article data-aos="fade-up" data-aos-delay="90">
            <h3>Coding HQ</h3>
            <p data-i18n="codingHqText">CTO and co-founder of a coding community and web development studio with 10+ members.</p>
          </article>
          <article data-aos="fade-up" data-aos-delay="180">
            <h3 data-i18n="educationTitle">Education</h3>
            <p data-i18n="educationText">Bachelor 3rd year in AI and Big Data at Keyce Informatique, plus BTS in Software Engineering from IUGET Douala.</p>
          </article>
        </div>
      </section>

      <!-- ── STACK ──────────────────────────────────── -->
      <section class="section-band stack-section" id="stack" aria-labelledby="stack-title">
        <div class="section-head" data-aos="fade-up">
          <p class="section-index">/ 05</p>
          <div>
            <h2 id="stack-title" data-i18n="stackTitle">Stack.</h2>
          </div>
        </div>

        <div class="stack-board" data-aos="fade-up">
          <div class="stack-group">
            <h3 data-i18n="stackAutomation">Automation</h3>
            <ul class="logo-grid" aria-label="Automation stack">
              <li><img src="assets/logos/n8n.svg"      alt="" loading="lazy" /><span>n8n</span></li>
              <li><img src="assets/logos/zapier.svg"   alt="" loading="lazy" /><span>Zapier</span></li>
              <li><img src="assets/logos/postman.svg"  alt="" loading="lazy" /><span>Postman</span></li>
              <li><img src="assets/logos/airtable.svg" alt="" loading="lazy" /><span>Airtable</span></li>
            </ul>
          </div>
          <div class="stack-group">
            <h3 data-i18n="stackAi">AI and data</h3>
            <ul class="logo-grid" aria-label="AI and data stack">
              <li><img src="assets/logos/python.svg"       alt="" loading="lazy" /><span>Python</span></li>
              <li><img src="assets/logos/pytorch.svg"      alt="" loading="lazy" /><span>PyTorch</span></li>
              <li><img src="assets/logos/tensorflow.svg"   alt="" loading="lazy" /><span>TensorFlow</span></li>
              <li><img src="assets/logos/scikitlearn.svg"  alt="" loading="lazy" /><span>scikit-learn</span></li>
              <li><img src="assets/logos/huggingface.svg"  alt="" loading="lazy" /><span>Hugging Face</span></li>
              <li><img src="assets/logos/openai.svg"       alt="" loading="lazy" /><span>OpenAI</span></li>
            </ul>
          </div>
          <div class="stack-group">
            <h3 data-i18n="stackWeb">Web and apps</h3>
            <ul class="logo-grid" aria-label="Web and app stack">
              <li><img src="assets/logos/javascript.svg"  alt="" loading="lazy" /><span>JavaScript</span></li>
              <li><img src="assets/logos/typescript.svg"  alt="" loading="lazy" /><span>TypeScript</span></li>
              <li><img src="assets/logos/react.svg"       alt="" loading="lazy" /><span>React</span></li>
              <li><img src="assets/logos/html5.svg"       alt="" loading="lazy" /><span>HTML5</span></li>
              <li><img src="assets/logos/css.svg"         alt="" loading="lazy" /><span>CSS</span></li>
              <li><img src="assets/logos/django.svg"      alt="" loading="lazy" /><span>Django</span></li>
              <li><img src="assets/logos/nodedotjs.svg"   alt="" loading="lazy" /><span>Node.js</span></li>
              <li><img src="assets/logos/php.svg"         alt="" loading="lazy" /><span>PHP</span></li>
            </ul>
          </div>
          <div class="stack-group">
            <h3 data-i18n="stackTools">Tools</h3>
            <ul class="logo-grid" aria-label="Tools stack">
              <li><img src="assets/logos/git.svg"               alt="" loading="lazy" /><span>Git</span></li>
              <li><img src="assets/logos/visualstudiocode.svg"  alt="" loading="lazy" /><span>VS Code</span></li>
              <li><img src="assets/logos/figma.svg"             alt="" loading="lazy" /><span>Figma</span></li>
              <li><img src="assets/logos/canva.svg"             alt="" loading="lazy" /><span>Canva</span></li>
              <li><img src="assets/logos/adobephotoshop.svg"    alt="" loading="lazy" /><span>Photoshop</span></li>
              <li><img src="assets/logos/github.svg"            alt="" loading="lazy" /><span>GitHub</span></li>
            </ul>
          </div>
        </div>
      </section>

      <!-- ── WHY / SIGNAL ───────────────────────────── -->
      <section class="section-band why-section" aria-labelledby="why-title">
        <div class="section-head" data-aos="fade-up">
          <p class="section-index">/ 06</p>
          <div>
            <h2 id="why-title" data-i18n="whyTitle">Signal.</h2>
          </div>
        </div>
        <div class="why-panel" data-aos="fade-up">
          <p data-i18n="whyText">I sit at the intersection of automation, AI, data, and web software. That makes me useful when a project needs more than a single feature: it needs data to move, tools to talk, users to understand the output, and a technical partner who can learn fast.</p>
          <pre aria-hidden="true">
if (manual_work || disconnected_tools) {
  map_process();
  build_system();
  document_handoff();
}</pre>
        </div>
      </section>

      <!-- ── CONTACT ─────────────────────────────────── -->
      <section class="section-band contact-section" id="contact" aria-labelledby="contact-title">
        <div class="contact-panel" data-aos="fade-up">
          <p class="section-index">/ contact</p>
          <h2 id="contact-title" data-i18n="contactTitle">Let's build.</h2>
          <p data-i18n="contactLead">Reach out for automation, AI integration, ETL, web/app builds, data analysis, or recruiter conversations.</p>
          <div class="contact-actions">
            <a class="button button-primary"   href="mailto:nonagnijordan@gmail.com">nonagnijordan@gmail.com</a>
            <a class="button button-secondary" href="https://wa.me/237681178490">WhatsApp</a>
          </div>
        </div>
      </section>

      <footer class="site-footer">
        <pre aria-hidden="true">[0d4vid] :: Douala, Cameroon :: AI / automation / data / web</pre>
        <button class="footer-lang" type="button" data-lang-toggle data-i18n="footerLang">Passer en francais</button>
      </footer>

    </main>

    <script src="https://unpkg.com/aos@next/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.15/dist/ScrollTrigger.min.js"></script>
    <script src="script.js"></script>
  </body>
</html>
